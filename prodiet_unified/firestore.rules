rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow read/write to FCM tokens when authenticated as the token owner
    match /fcm_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Only allow read/write to other documents when authenticated
    match /{document=**} {
      allow read, write: if request.auth != null && !(request.path[3] == 'fcm_tokens');
    }
  }
}
